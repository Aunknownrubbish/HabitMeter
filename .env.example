# AMap JavaScript API key used by the browser map SDK.
NEXT_PUBLIC_AMAP_KEY=your_amap_js_api_key

# AMap JavaScript security config value.
NEXT_PUBLIC_AMAP_SECRET=your_amap_js_security_config

# AMap Web Service key used only by server-side route proxy APIs.
AMAP_WEB_KEY=your_amap_web_service_key

# NextAuth secret. Generate a strong random value for each environment.
AUTH_SECRET=your_auth_secret

# Prisma database URL.
# Local development example:
DATABASE_URL="file:./dev.db"
